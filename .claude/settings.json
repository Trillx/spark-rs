{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing with git.cafe"
          }
        ]
      }
    ]
  }
}
